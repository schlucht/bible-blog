    <meta name="viewport"
        content="width=device-width, initial-scale=1">
    <title>
        {{ block "title" .}}
        {{ end }}
    </title>
    <link href="/assets/style.css"
        rel="stylesheet"
        type="text/css">
    <script src="/assets/js/htmx.min.js"
        defer></script>
    <script src="/assets/js/main.js"
        type="module"></script>

</head>

<body>
    <main class="container">
        {{ block "content" .}}{{ end }}
    </main>
</body>
{{ end }}